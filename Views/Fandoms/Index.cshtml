@model IEnumerable<Uc_10_kauane_FandomWorld.Models.Fandom>

@{
    ViewData["Title"] = "Index";
}
<div class="pagina">

    <h1>Fandom</h1>

    <div class="criar">
        <a asp-action="Create">
            <img src="~/imagem/Adicionar.png" alt="Adicionar" />
            Adicionar Fandom
        </a>
    </div>



    <form asp-action="Index" method="get">
        <div class="input-group mb-3">
            <input type="text" class="form-control" name="searchString" placeholder="Pesquisar pelo nome do Fandom...">
            <div class="input-group-append">
                <button class="btn btn-outline-secondary" type="submit">Pesquisar</button>
            </div>
        </div>
    </form>


    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.NomeFandom)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Descricao)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Categoria)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.NomeFandom)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descricao)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Categoria)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.FandomId"><img class="acoes" src="~/imagem/Editar.png" alt="Editar" /> </a>|
                        <a asp-action="Details" asp-route-id="@item.FandomId"><img class="acoes" src="~/imagem/Detalhes.png" alt="Detalhes" /></a> |
                        <a asp-action="Delete" asp-route-id="@item.FandomId"><img class="acoes" src="~/imagem/Excluir.png" alt="Excluir" /></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
</div>
